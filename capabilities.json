{
  "dataRoles": [
    {
      "displayName": "Categories",
      "name": "categories",
      "kind": "Grouping",
      "description": "Add hierarchy fields in order — 1st field = Level 1, 2nd = Level 2, 3rd = Level 3"
    },
    {
      "displayName": "Images",
      "name": "images",
      "kind": "Grouping",
      "description": "Optional image URL columns — one per level, in the same order as Categories"
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "Optional measure to display as a badge on each chip (aggregated per hierarchy level)"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Optional extra fields shown in the tooltip when hovering a chip"
    }
  ],
