  "privileges": [],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "categories": {
            "max": 3
          },
          "images": {
            "max": 3
          },
          "tooltips": {
            "max": 5
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "categories"
              }
            },
            {
              "bind": {
                "to": "images"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 2000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "values"
              }
            }
          ]
        }
      }
    }
  ],
  "supportsKeyboardFocus": true,
